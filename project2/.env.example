# Environment Variables for JWKS Server
# Copy this file to .env and set your own values

# AES Encryption Key for Private Keys
# REQUIRED: Used to encrypt/decrypt RSA private keys in the database
# IMPORTANT: Never commit the actual key to version control!
# Use a strong, random key with sufficient entropy
NOT_MY_KEY=change-me-to-a-secure-random-string

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set a secure key
# 3. Load before running: export $(cat .env | xargs) && python3 app.py
# 4. Or set directly: export NOT_MY_KEY="your-secret-key" && python3 app.py
